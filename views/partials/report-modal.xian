<!-- html2pdf library for client-side direct PDF download (deferred for non-blocking page load) -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js" defer></script>

<style>
  /* Modal Direct Print Stylesheet (Shows Full Print Preview in Browser) */
  @media print {
    body.printing-modal > *:not(#dali-report-modal) {
      display: none !important;
    }
    body.printing-modal {
      background: #ffffff !important;
      color: #000000 !important;
      margin: 0 !important;
      padding: 0 !important;
    }
    body.printing-modal #dali-report-modal {
      position: static !important;
      display: block !important;
      background: #ffffff !important;
      padding: 0 !important;
      margin: 0 !important;
      width: 100% !important;
      max-width: 100% !important;
      box-shadow: none !important;
      overflow: visible !important;
      inset: auto !important;
    }
    body.printing-modal #dali-report-modal > div {
      box-shadow: none !important;
      border: none !important;
      max-width: 100% !important;
      width: 100% !important;
      padding: 0 !important;
      margin: 0 !important;
      max-height: none !important;
      overflow: visible !important;
      background: #ffffff !important;
      border-radius: 0 !important;
    }
    body.printing-modal #dali-report-modal .no-print-modal,
    body.printing-modal #dali-report-modal .sticky,
    body.printing-modal #dali-report-modal .modal-footer-bar {
      display: none !important;
    }
    body.printing-modal #dali-report-modal .modal-body-scroll {
      background: #ffffff !important;
      padding: 0 !important;
      margin: 0 !important;
      overflow: visible !important;
    }
    body.printing-modal #modal-report-content {
      display: block !important;
      box-shadow: none !important;
      border: none !important;
      padding: 0 !important;
      margin: 0 !important;
      width: 100% !important;
      max-width: 100% !important;
      background: #ffffff !important;
    }
    .print-avoid-break {
      break-inside: avoid !important;
      page-break-inside: avoid !important;
    }
    @page {
      size: A4 portrait;
      margin: 12mm 10mm 12mm 10mm;
    }
  }
</style>

<!-- Universal Report Export & Preview Modal (No Page Navigation) -->
<div id="dali-report-modal" class="fixed inset-0 z-[9999] hidden items-center justify-center p-2 sm:p-4 md:p-6 bg-slate-900/80 backdrop-blur-sm overflow-y-auto transition-opacity duration-200">
  <div class="relative w-full max-w-5xl my-auto bg-slate-100 rounded-3xl shadow-2xl border border-slate-300 flex flex-col overflow-hidden max-h-[94vh] animate-in fade-in zoom-in-95 duration-150">
    
    <!-- Modal Sticky Action Bar Header -->
    <div class="sticky top-0 z-20 flex flex-wrap items-center justify-between bg-white px-5 py-3.5 border-b border-slate-200 shadow-sm gap-3 no-print-modal">
      <div class="flex items-center space-x-2.5">
        <span class="w-9 h-9 rounded-xl bg-dali-100 text-dali-700 flex items-center justify-center font-bold text-sm shadow-sm">
          <i class="fas fa-file-invoice"></i>
        </span>
        <div>
          <div class="flex items-center gap-2">
            <h3 class="font-extrabold text-slate-900 text-sm sm:text-base leading-none">Inspection Report Preview</h3>
            <span id="modal-report-code" class="px-2 py-0.5 rounded text-[11px] font-mono font-extrabold bg-slate-100 text-slate-700 border border-slate-200">
              Loading...
            </span>
          </div>
          <p class="text-[11px] text-slate-500 mt-0.5">Official DALI certificate preview &bull; Export to PDF or Print</p>
        </div>
      </div>

      <!-- Header Action Buttons -->
      <div class="flex items-center space-x-2.5">
        <button type="button" id="modal-export-pdf-btn" onclick="exportModalToPdf()" class="px-4 py-2 rounded-xl bg-rose-700 hover:bg-rose-800 text-white font-extrabold text-xs shadow-md flex items-center gap-1.5 transition-all hover:scale-[1.02] cursor-pointer" title="Download directly as PDF file">
          <i class="fas fa-file-pdf"></i> Export to PDF
        </button>
        <button type="button" onclick="printModalReport()" class="px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-extrabold text-xs shadow-md flex items-center gap-1.5 transition-all hover:scale-[1.02] cursor-pointer" title="Print with full preview">
          <i class="fas fa-print"></i> Print Record
        </button>
        <button type="button" onclick="closeReportModal()" class="w-9 h-9 rounded-xl bg-slate-100 hover:bg-rose-100 hover:text-rose-700 text-slate-500 flex items-center justify-center font-bold text-base transition-colors cursor-pointer" title="Close Preview (Esc)">
          <i class="fas fa-xmark"></i>
        </button>
      </div>
    </div>

    <!-- Modal Scrollable Content Container -->
    <div class="modal-body-scroll flex-grow overflow-y-auto p-3 sm:p-6 md:p-8 bg-slate-200/50 flex justify-center">
      
      <!-- Loading Spinner Skeleton -->
      <div id="modal-report-loading" class="py-16 text-center space-y-4">
        <div class="inline-block w-10 h-10 border-4 border-slate-300 border-t-dali-700 rounded-full animate-spin"></div>
        <p class="text-sm font-bold text-slate-600">Generating live inspection certificate preview...</p>
      </div>

      <!-- Report Document Paper Sheet Preview -->
      <div id="modal-report-content" class="hidden bg-white rounded-2xl p-6 sm:p-10 md:p-12 shadow-xl border border-slate-200 max-w-[920px] w-full space-y-8 my-auto">
        <!-- Dynamic content injected via fetch() -->
      </div>

    </div>

    <!-- Modal Footer Help Bar -->
    <div class="modal-footer-bar bg-slate-50 px-5 py-2.5 border-t border-slate-200 text-xs text-slate-500 flex items-center justify-between no-print-modal">
      <span><i class="fas fa-circle-info mr-1 text-slate-400"></i> Click <strong>Export to PDF</strong> to download the file directly, or <strong>Print Record</strong> for physical copy</span>
      <button type="button" onclick="closeReportModal()" class="font-bold text-slate-700 hover:underline cursor-pointer">Close Window</button>
    </div>

  </div>
</div>

<script>
  // High-performance client-side cache for instant 0ms modal opening
  const reportModalClientCache = new Map();

  // Open the report modal without navigating away from the page
  window.openReportModal = function(id) {
    const modal = document.getElementById('dali-report-modal');
    const loading = document.getElementById('modal-report-loading');
    const content = document.getElementById('modal-report-content');
    const codeBadge = document.getElementById('modal-report-code');

    if (!modal) return;

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';

    // ⚡ INSTANT CACHE HIT: Render immediately with zero wait or spinner
    if (reportModalClientCache.has(id)) {
      const cached = reportModalClientCache.get(id);
      content.innerHTML = cached.html;
      if (codeBadge) codeBadge.textContent = cached.code;
      loading.classList.add('hidden');
      content.classList.remove('hidden');
      return;
    }

    loading.classList.remove('hidden');
    content.classList.add('hidden');
    content.innerHTML = '';
    codeBadge.textContent = 'Loading...';

    fetch('/reports/modal/' + encodeURIComponent(id))
      .then(res => {
        if (!res.ok) throw new Error('Report could not be retrieved.');
        return res.text();
      })
      .then(html => {
        content.innerHTML = html;
        loading.classList.add('hidden');
        content.classList.remove('hidden');

        // Extract report code from content if available
        let reportCode = 'REP-' + id;
        const codeElem = content.querySelector('.font-mono.text-xl');
        if (codeElem && codeElem.textContent.trim()) {
          reportCode = codeElem.textContent.trim();
        }
        codeBadge.textContent = reportCode;

        // Cache for subsequent instant opens
        reportModalClientCache.set(id, { html, code: reportCode });
      })
      .catch(err => {
        loading.classList.add('hidden');
        content.classList.remove('hidden');
        content.innerHTML = `
          <div class="py-12 text-center space-y-3">
            <div class="w-12 h-12 mx-auto rounded-full bg-rose-100 text-rose-600 flex items-center justify-center text-xl font-bold">
              <i class="fas fa-circle-exclamation"></i>
            </div>
            <h4 class="font-bold text-slate-900 text-base">Unable to Load Preview</h4>
            <p class="text-sm text-slate-500 max-w-md mx-auto">${err.message || 'Please check if the inspection record is available.'}</p>
            <button onclick="closeReportModal()" class="px-4 py-2 bg-slate-900 text-white rounded-xl text-xs font-bold">Close</button>
          </div>
        `;
      });
  };

  // Close the modal
  window.closeReportModal = function() {
    const modal = document.getElementById('dali-report-modal');
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  };

  // Direct PDF Download using html2pdf
  window.exportModalToPdf = function() {
    const element = document.getElementById('modal-report-content');
    const codeBadge = document.getElementById('modal-report-code');
    const btn = document.getElementById('modal-export-pdf-btn');

    if (!element || !element.innerHTML) return;

    const reportCode = (codeBadge?.textContent || 'Inspection_Report').trim().replace(/[^a-zA-Z0-9_-]/g, '_');
    const originalText = btn.innerHTML;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generating PDF...';
    btn.disabled = true;

    const opt = {
      margin: [10, 8, 10, 8],
      filename: `DALI_Inspection_${reportCode}.pdf`,
      image: { type: 'jpeg', quality: 0.98 },
      html2canvas: { scale: 2, useCORS: true, logging: false },
      jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
    };

    const doSave = () => {
      window.html2pdf().set(opt).from(element).save().then(() => {
        btn.innerHTML = '<i class="fas fa-check text-emerald-300"></i> Downloaded!';
        setTimeout(() => {
          btn.innerHTML = originalText;
          btn.disabled = false;
        }, 1500);
      }).catch(err => {
        console.error("PDF generation error:", err);
        btn.innerHTML = originalText;
        btn.disabled = false;
        printModalReport();
      });
    };

    if (window.html2pdf) {
      doSave();
    } else {
      const script = document.createElement('script');
      script.src = 'https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js';
      script.onload = () => doSave();
      script.onerror = () => {
        btn.innerHTML = originalText;
        btn.disabled = false;
        printModalReport();
      };
      document.head.appendChild(script);
    }
  };

  // Print with full visible print preview
  window.printModalReport = function() {
    const content = document.getElementById('modal-report-content');
    if (!content || !content.innerHTML) return;

    document.body.classList.add('printing-modal');

    setTimeout(() => {
      window.print();
      setTimeout(() => {
        document.body.classList.remove('printing-modal');
      }, 600);
    }, 120);
  };

  // Close on Escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeReportModal();
    }
  });

  // Close on backdrop click & Background prefetch
  document.addEventListener('DOMContentLoaded', function() {
    const modal = document.getElementById('dali-report-modal');
    if (modal) {
      modal.addEventListener('click', function(e) {
        if (e.target === modal) {
          closeReportModal();
        }
      });
    }

    // 🚀 Background Prefetch: Load reports in memory so Export button opens instantly
    const prefetchReports = () => {
      const buttons = document.querySelectorAll('[onclick*="openReportModal"]');
      const ids = new Set();
      buttons.forEach(btn => {
        const attr = btn.getAttribute('onclick') || '';
        const match = attr.match(/openReportModal\(['"]([^'"]+)['"]\)/);
        if (match && match[1]) ids.add(match[1]);
      });

      Array.from(ids).slice(0, 15).forEach(id => {
        if (!reportModalClientCache.has(id)) {
          fetch('/reports/modal/' + encodeURIComponent(id))
            .then(res => res.ok ? res.text() : null)
            .then(html => {
              if (html) {
                const temp = document.createElement('div');
                temp.innerHTML = html;
                const codeElem = temp.querySelector('.font-mono.text-xl');
                const code = codeElem?.textContent?.trim() || ('REP-' + id);
                reportModalClientCache.set(id, { html, code });
              }
            })
            .catch(() => {});
        }
      });
    };

    if ('requestIdleCallback' in window) {
      requestIdleCallback(prefetchReports, { timeout: 1500 });
    } else {
      setTimeout(prefetchReports, 400);
    }
  });
</script>
