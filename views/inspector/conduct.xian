{{> head}}
<body class="flex flex-col min-h-screen bg-slate-50 text-slate-800">
  {{> navbar}}
  {{> alerts}}

  <main class="flex-grow py-8 px-4 sm:px-6 lg:px-8 w-full space-y-6">
    
    <!-- Audit Banner Card -->
    <div class="bg-gradient-to-r from-slate-900 to-slate-800 rounded-2xl p-6 text-white shadow-md">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-white/20 text-white">
              Inspection {{inspection.inspectionCode}}
            </span>
            {{statusBadge inspection.status}}
            {{#if inspection.stockBranchCode}}
              <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-950/80 text-rose-200 border border-rose-700/60 inline-flex items-center gap-1">
                <i class="fas fa-boxes-stacked text-xs"></i> Stock: {{inspection.stockBranchCode}}{{#if inspection.stockSku}} ({{inspection.stockSku}}){{/if}}
              </span>
            {{/if}}
          </div>
          <h1 class="text-2xl font-black">{{inspection.store.name}}</h1>
          <p class="text-sm text-slate-300 mt-1">
            <i class="fas fa-location-dot mr-1"></i> {{inspection.store.address}} &bull; Branch Code: {{inspection.store.code}}
          </p>
        </div>

        <div class="bg-white/10 backdrop-blur-md rounded-xl p-4 border border-white/20 text-center min-w-[170px]">
          <div class="text-xs uppercase font-bold tracking-wider text-slate-300">Live Calculated Score</div>
          <div id="liveScoreDisplay" class="text-3xl font-black text-yellow-400 mt-1">100%</div>
          <div class="text-xs text-emerald-400 font-bold" id="liveStatusBadge">100% Compliant</div>
        </div>
      </div>
    </div>

    <!-- The Form (Checklist Items, Findings, and Evidence Photos) -->
    <form method="POST" action="/inspector/conduct/{{inspection.id}}" enctype="multipart/form-data" class="space-y-6">

      {{#each categories}}
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="bg-slate-50 px-6 py-4 border-b border-slate-200 flex items-center justify-between">
            <div class="flex items-center space-x-2">
              <span class="w-3 h-3 rounded-full bg-dali-700"></span>
              <h3 class="font-extrabold text-sm text-slate-900 uppercase tracking-wider">{{this.name}}</h3>
            </div>
            <span class="text-xs font-bold text-slate-500">{{this.items.length}} items</span>
          </div>

          <div class="divide-y divide-slate-100 p-6 space-y-6">
            {{#each this.items}}
              <div class="pt-4 first:pt-0 checklist-item-row" data-weight="{{this.weight}}" id="row_{{this.id}}">
                <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
                  <div class="flex-grow space-y-1">
                    <div class="flex items-center gap-2 flex-wrap">
                      <span class="text-xs font-mono font-bold text-slate-500 bg-slate-100 px-2 py-0.5 rounded">Item #{{this.id}}</span>
                      <h4 class="font-bold text-base text-slate-900">{{this.requirement}}</h4>
                      <span class="text-xs font-bold text-slate-600 bg-slate-100 px-2 py-0.5 rounded">{{this.weight}} pts</span>
                      {{severityBadge this.criticality}}
                    </div>
                    <p class="text-sm text-slate-600 leading-relaxed">{{this.description}}</p>
                  </div>

                  <!-- Radio Options -->
                  <div class="flex items-center gap-2 shrink-0">
                    <label class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl border border-slate-200 cursor-pointer hover:bg-emerald-50 transition-colors has-[:checked]:bg-emerald-50 has-[:checked]:border-emerald-500 has-[:checked]:text-emerald-800 text-xs font-bold text-slate-700">
                      <input 
                        type="radio" 
                        name="result_{{this.id}}" 
                        value="Compliant" 
                        class="accent-emerald-600"
                        checked 
                        onchange="handleResultChange({{this.id}}, 'Compliant')"
                      >
                      <span>Compliant</span>
                    </label>

                    <label class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl border border-slate-200 cursor-pointer hover:bg-rose-50 transition-colors has-[:checked]:bg-rose-50 has-[:checked]:border-rose-500 has-[:checked]:text-rose-800 text-xs font-bold text-slate-700">
                      <input 
                        type="radio" 
                        name="result_{{this.id}}" 
                        value="Noncompliant" 
                        class="accent-rose-600"
                        onchange="handleResultChange({{this.id}}, 'Noncompliant')"
                      >
                      <span>Not Compliant</span>
                    </label>

                    <label class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl border border-slate-200 cursor-pointer hover:bg-slate-100 transition-colors has-[:checked]:bg-slate-100 text-xs font-semibold text-slate-500">
                      <input 
                        type="radio" 
                        name="result_{{this.id}}" 
                        value="N/A" 
                        class="accent-slate-500"
                        onchange="handleResultChange({{this.id}}, 'N/A')"
                      >
                      <span>N/A</span>
                    </label>
                  </div>
                </div>

                <!-- Finding Recorder Drawer (Appears when Noncompliant is selected) -->
                <div id="finding_drawer_{{this.id}}" class="hidden mt-4 p-5 rounded-xl bg-rose-50/70 border border-rose-200 space-y-3">
                  <div class="flex items-center justify-between text-sm font-bold text-rose-950 pb-2 border-b border-rose-200">
                    <span><i class="fas fa-triangle-exclamation mr-1.5 text-rose-600"></i> Record Sanitation Issue &amp; Violation Details</span>
                    <span class="text-xs text-rose-600 font-bold uppercase">Action Required</span>
                  </div>

                  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-sm">
                    <div class="sm:col-span-2">
                      <label class="block font-bold text-rose-950 mb-1">Issue Headline</label>
                      <input 
                        type="text" 
                        name="finding_title_{{this.id}}" 
                        value="Issue: {{this.requirement}}" 
                        class="w-full p-2.5 text-sm border border-rose-300 rounded-xl bg-white outline-none focus:ring-2 focus:ring-rose-500 text-slate-800"
                      >
                    </div>
                    <div>
                      <label class="block font-bold text-rose-950 mb-1">Severity Level</label>
                      <select name="finding_severity_{{this.id}}" class="w-full p-2.5 text-sm border border-rose-300 rounded-xl bg-white outline-none focus:ring-2 focus:ring-rose-500 text-slate-800">
                        <option value="Critical" {{#if (eq this.criticality 'Critical')}}selected{{/if}}>Critical</option>
                        <option value="Major" {{#if (eq this.criticality 'Major')}}selected{{/if}}>Major</option>
                        <option value="Minor" {{#if (eq this.criticality 'Minor')}}selected{{/if}}>Minor</option>
                      </select>
                    </div>
                  </div>

                  <div>
                    <label class="block font-bold text-rose-950 text-sm mb-1">Inspector Notes &amp; Specific Observations</label>
                    <textarea 
                      name="remarks_{{this.id}}" 
                      rows="2" 
                      placeholder="e.g. Temperature probe reading was 8.2°C; temperature sheet was missing 2 days of logs."
                      class="w-full p-2.5 text-sm border border-rose-300 rounded-xl bg-white outline-none focus:ring-2 focus:ring-rose-500 text-slate-800"
                    ></textarea>
                  </div>

                  <!-- Optional DALIStock Product SKU link -->
                  <div class="pt-2 border-t border-rose-200">
                    <label class="block font-bold text-rose-950 text-xs mb-1">
                      <i class="fas fa-boxes-stacked text-rose-600 mr-1"></i> Associated Catalog Product / SKU (Optional)
                    </label>
                    <select 
                      name="finding_sku_{{this.id}}" 
                      class="w-full p-2 text-xs border border-rose-300 rounded-xl bg-white outline-none focus:ring-2 focus:ring-rose-500 text-slate-800"
                    >
                      <option value="">— General Area Sanitation (No Specific SKU) —</option>
                      {{#each ../../stockProducts}}
                        <option value="{{this.sku}}">[{{this.sku}}] {{this.name}} ({{this.category}})</option>
                      {{/each}}
                    </select>
                    <p class="text-[11px] text-rose-700 mt-1">Select a catalog SKU only if this finding pertains to spoiled or improperly stored products.</p>
                  </div>
                </div>

                <!-- General Compliant Remarks (hidden if noncompliant) -->
                <div id="remarks_box_{{this.id}}" class="mt-2 text-sm">
                  <input 
                    type="text" 
                    name="remarks_{{this.id}}" 
                    placeholder="Inspector observation notes (optional)..." 
                    class="w-full px-3.5 py-2 text-sm border border-slate-200 rounded-xl outline-none focus:border-slate-400 text-slate-700 bg-slate-50/50"
                  >
                </div>
              </div>
            {{/each}}
          </div>
        </div>
      {{/each}}

      <!-- Photo & Evidence Upload Section -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
          <div class="flex items-center space-x-2.5">
            <i class="fas fa-camera text-dali-700 text-xl"></i>
            <div>
              <h3 class="font-bold text-base text-slate-900">Inspection Photo Proof</h3>
              <p class="text-sm text-slate-500">Attach photos of thermometer readings, display condition, or sanitation logs</p>
            </div>
          </div>
          <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-100 text-slate-600">Up to 5 photos</span>
        </div>

        <div>
          <label class="block text-sm font-bold text-slate-800 mb-1">Choose Photos from Device</label>
          <input 
            type="file" 
            name="evidencePhotos" 
            id="evidencePhotos" 
            multiple 
            accept="image/*"
            class="block w-full text-sm text-slate-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-bold file:bg-dali-50 file:text-dali-700 hover:file:bg-dali-100 cursor-pointer"
          >
        </div>

        <div>
          <label class="block text-sm font-bold text-slate-800 mb-1">Photo Description / Caption</label>
          <input 
            type="text" 
            name="evidenceCaption" 
            placeholder="e.g. Digital thermometer probe test on dairy cooler and produce display check" 
            class="w-full p-3 text-sm border border-slate-300 rounded-xl outline-none focus:ring-2 focus:ring-dali-600 text-slate-800"
          >
        </div>
      </div>

      <!-- Action Submission Bar -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <div class="text-base font-bold text-slate-900">Finalize &amp; Submit Inspection Audit</div>
          <div class="text-sm text-slate-500">Submitting will calculate the final score and notify the store manager of any issues found.</div>
        </div>

        <div class="flex items-center gap-3 w-full sm:w-auto">
          <a href="/inspector/dashboard" class="w-1/2 sm:w-auto px-5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-bold text-center">
            Save Draft / Exit
          </a>
          <button 
            type="submit" 
            class="w-1/2 sm:w-auto px-7 py-2.5 rounded-xl bg-dali-700 hover:bg-dali-800 text-white text-sm font-bold shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2"
          >
            <i class="fas fa-check-circle"></i> Submit Inspection Report
          </button>
        </div>
      </div>

    </form>

  </main>

  <script>
    function handleResultChange(itemId, result) {
      const drawer = document.getElementById('finding_drawer_' + itemId);
      const normalRemarks = document.getElementById('remarks_box_' + itemId);

      if (result === 'Noncompliant') {
        drawer.classList.remove('hidden');
        if (normalRemarks) normalRemarks.classList.add('hidden');
      } else {
        drawer.classList.add('hidden');
        if (normalRemarks) normalRemarks.classList.remove('hidden');
      }

      calculateLiveScore();
    }

    function calculateLiveScore() {
      const rows = document.querySelectorAll('.checklist-item-row');
      let totalWeight = 0;
      let earnedWeight = 0;
      let noncompliantCount = 0;

      rows.forEach(row => {
        const weight = parseInt(row.getAttribute('data-weight')) || 10;
        const selected = row.querySelector('input[type="radio"]:checked');
        
        if (selected) {
          if (selected.value === 'Compliant') {
            totalWeight += weight;
            earnedWeight += weight;
          } else if (selected.value === 'Noncompliant') {
            totalWeight += weight;
            noncompliantCount++;
          }
        }
      });

      const score = totalWeight > 0 ? Math.round((earnedWeight / totalWeight) * 100) : 100;
      const display = document.getElementById('liveScoreDisplay');
      const badge = document.getElementById('liveStatusBadge');

      display.textContent = score + '%';
      
      if (noncompliantCount > 0) {
        display.className = 'text-3xl font-black text-rose-400 mt-1';
        badge.textContent = noncompliantCount + ' Issue(s) Found – Not Compliant';
        badge.className = 'text-xs text-rose-400 font-bold';
      } else {
        display.className = 'text-3xl font-black text-emerald-400 mt-1';
        badge.textContent = '100% Compliant';
        badge.className = 'text-xs text-emerald-400 font-bold';
      }
    }
  </script>

  {{> footer}}
</body>
</html>
