{{> head}}
<body class="flex flex-col min-h-screen bg-slate-50 text-slate-800">
  {{> navbar}}
  {{> alerts}}

  <main class="flex-grow py-8 px-4 sm:px-6 lg:px-8 w-full space-y-6">
    
    <!-- Header -->
    <div class="flex items-center justify-between bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
      <div class="flex items-center space-x-3">
        <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-700 border border-amber-200 flex items-center justify-center text-xl shadow-sm">
          <i class="fas fa-magnifying-glass-check"></i>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-xl font-extrabold text-slate-900 tracking-tight">Review &amp; Verify Store Fix</h1>
            <span class="px-2.5 py-0.5 rounded text-xs font-bold bg-blue-100 text-blue-800">Inspector Verification</span>
          </div>
          <p class="text-sm text-slate-500 mt-0.5">
            Review the photos and explanation submitted by the store representative to decide if the issue has been resolved.
          </p>
        </div>
      </div>
      
      <a href="/inspector/dashboard" class="text-sm font-bold text-slate-600 hover:text-slate-900">
        &larr; Back to My Inspections
      </a>
    </div>

    <!-- Finding & Violation Details -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-slate-100">
        <div>
          <span class="font-mono text-xs font-bold text-slate-400">Inspection {{action.inspection.inspectionCode}}</span>
          <h2 class="text-lg font-bold text-slate-900 mt-0.5">{{action.finding.title}}</h2>
          <p class="text-sm text-slate-600">Store: <strong>{{action.inspection.store.name}}</strong> &bull; Manager: {{action.inspection.store.managerName}}</p>
        </div>
        <div>
          {{severityBadge action.finding.severity}}
        </div>
      </div>

      <div class="bg-rose-50/70 p-4 rounded-xl border border-rose-200 text-sm text-rose-950 space-y-1">
        <span class="font-bold text-xs uppercase tracking-wider text-rose-700 block">Original Problem Recorded During Inspection:</span>
        <p class="leading-relaxed">{{action.finding.description}}</p>
      </div>
    </div>

    <!-- Store Representative Submitted Proof Card -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-slate-100">
        <div class="flex items-center space-x-2">
          <i class="fas fa-check-to-slot text-emerald-600 text-lg"></i>
          <div>
            <h3 class="font-bold text-base text-slate-900">Store Representative's Submitted Proof</h3>
            <p class="text-xs text-slate-500">Submitted at {{formatDateTime action.submittedAt}}</p>
          </div>
        </div>
        <span class="px-3 py-1 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200">
          {{statusLabel action.status}}
        </span>
      </div>

      <div class="space-y-3 text-sm">
        <div>
          <span class="font-bold text-slate-800 block mb-1">What the store did to fix the issue:</span>
          <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-200 text-slate-800 leading-relaxed">
            {{action.actionPlan}}
          </div>
        </div>

        {{#if action.remediationNotes}}
          <div>
            <span class="font-bold text-slate-800 block mb-1">Preventive Measures / Extra Notes:</span>
            <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-200 text-slate-800 leading-relaxed">
              {{action.remediationNotes}}
            </div>
          </div>
        {{/if}}

        <!-- Evidence Gallery -->
        {{#if (gt action.evidences.length 0)}}
          <div class="pt-2">
            <span class="font-bold text-slate-800 block mb-2">Attached Proof Photos:</span>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
              {{#each action.evidences}}
                <div class="border border-slate-200 rounded-xl overflow-hidden bg-slate-50 shadow-sm">
                  <img src="{{this.filePath}}" alt="Evidence photo" class="h-40 w-full object-cover">
                  <div class="p-2.5 text-xs text-slate-600">
                    <span class="font-bold block truncate">{{this.caption}}</span>
                    <span class="text-slate-400">Attached by store</span>
                  </div>
                </div>
              {{/each}}
            </div>
          </div>
        {{/if}}
      </div>
    </div>

    <!-- Inspector Verification Decision Form -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
      <div class="pb-3 border-b border-slate-100 mb-4">
        <h3 class="font-bold text-base text-slate-900">Your Verification Decision</h3>
        <p class="text-sm text-slate-500">Approving will mark this problem as resolved. If all items are resolved, the store inspection will be marked as compliant.</p>
      </div>

      <form method="POST" action="/inspector/verify/{{action.id}}" class="space-y-4 text-sm">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <div>
          <label class="block font-bold text-slate-800 mb-2">Decision</label>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <label class="p-4 rounded-xl border-2 border-slate-200 hover:border-emerald-500 cursor-pointer transition-all has-[:checked]:border-emerald-600 has-[:checked]:bg-emerald-50/50 flex items-center space-x-3">
              <input type="radio" name="decision" value="APPROVE" class="accent-emerald-600" checked>
              <div>
                <span class="font-bold text-slate-900 block text-sm"><i class="fas fa-check-circle text-emerald-600 mr-1"></i> Approve Fix (Problem Resolved)</span>
                <span class="text-xs text-slate-500">The store has properly fixed the problem according to standards.</span>
              </div>
            </label>

            <label class="p-4 rounded-xl border-2 border-slate-200 hover:border-rose-500 cursor-pointer transition-all has-[:checked]:border-rose-600 has-[:checked]:bg-rose-50/50 flex items-center space-x-3">
              <input type="radio" name="decision" value="REJECT" class="accent-rose-600">
              <div>
                <span class="font-bold text-slate-900 block text-sm"><i class="fas fa-times-circle text-rose-600 mr-1"></i> Return to Store (Needs Rework)</span>
                <span class="text-xs text-slate-500">The fix or photo proof is insufficient. Ask the store to redo it.</span>
              </div>
            </label>
          </div>
        </div>

        <div>
          <label class="block font-bold text-slate-800 mb-1">Inspector Feedback / Audit Notes</label>
          <textarea 
            name="feedback" 
            rows="3" 
            placeholder="Document your observations, temperature readings, or instructions for the store..." 
            class="w-full p-3 border border-slate-300 rounded-xl outline-none focus:ring-2 focus:ring-dali-600 bg-white text-slate-800"
          >Remediation verified. Temperature readings and sanitation records are now compliant.</textarea>
        </div>

        <div class="pt-2 flex justify-end gap-3">
          <a href="/inspector/dashboard" class="px-5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-sm">
            Cancel
          </a>
          <button type="submit" class="px-6 py-2.5 rounded-xl bg-dali-700 hover:bg-dali-800 text-white font-bold text-sm shadow-sm transition-all">
            Submit Decision
          </button>
        </div>
      </form>
    </div>

  </main>

  {{> footer}}
</body>
</html>
