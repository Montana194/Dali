{{> head}}
<body class="storefront">
{{#if isAdmin}}
  {{> admin-header}}
  <div class="admin-shell">
    {{> admin-sidebar}}
    <main class="admin-content">
{{else}}
  {{#if isInspector}}
    {{> shop-nav}}
    <div class="admin-shell">
      <aside class="admin-sidebar">
        <p class="eyebrow">INSPECTOR MENU</p>
        <nav aria-label="Inspector navigation">
          <a href="/inspector"><i class="fas fa-clipboard-user" style="width:22px;opacity:0.75;"></i> My Inspections</a>
          <a href="/reports" style="background:#fdf2f8;color:var(--dali);font-weight:800;"><i class="fas fa-award" style="width:22px;opacity:0.9;"></i> Inspection Reports</a>
          <a href="/"><i class="fas fa-arrow-up-right-from-square" style="width:22px;opacity:0.75;"></i> Home Page</a>
          <form action="/logout" method="POST">
            <input type="hidden" name="_csrf" value="{{shopToken}}">
            <button type="submit"><i class="fas fa-right-from-bracket" style="width:22px;"></i> Sign Out</button>
          </form>
        </nav>
      </aside>
      <main class="admin-content">
  {{else}}
    {{#if isStoreRep}}
      {{> shop-nav}}
      <div class="admin-shell">
        <aside class="admin-sidebar">
          <p class="eyebrow">STORE MENU</p>
          <nav aria-label="Store navigation">
            <a href="/store"><i class="fas fa-store" style="width:22px;opacity:0.75;"></i> My Store</a>
            <a href="/reports" style="background:#fdf2f8;color:var(--dali);font-weight:800;"><i class="fas fa-award" style="width:22px;opacity:0.9;"></i> Inspection Reports</a>
            <a href="/"><i class="fas fa-arrow-up-right-from-square" style="width:22px;opacity:0.75;"></i> Home Page</a>
            <form action="/logout" method="POST">
              <input type="hidden" name="_csrf" value="{{shopToken}}">
              <button type="submit"><i class="fas fa-right-from-bracket" style="width:22px;"></i> Sign Out</button>
            </form>
          </nav>
        </aside>
        <main class="admin-content">
    {{else}}
      {{> shop-nav}}
      <main class="shop-container">
    {{/if}}
  {{/if}}
{{/if}}

    <div class="admin-title">
      <div>
        <p class="eyebrow">REPORTS</p>
        <h1>Inspection Reports</h1>
      </div>
    </div>
    <p class="admin-intro">The official result of each store inspection — score, grade, and status. Click “View Report” to see the full details or print it.</p>

    {{#if success_msg}}<p class="admin-notice" role="status">{{success_msg}}</p>{{/if}}
    {{#if error_msg}}<p class="admin-notice admin-notice-error" role="alert">{{error_msg}}</p>{{/if}}

    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th scope="col">Report No.</th>
            <th scope="col">Store</th>
            <th scope="col">Date</th>
            <th scope="col">Inspector</th>
            <th scope="col">Score</th>
            <th scope="col">Grade</th>
            <th scope="col">Status</th>
            <th scope="col">Action</th>
          </tr>
        </thead>
        <tbody>
          {{#each reports}}
            <tr>
              <td><strong>{{this.reportCode}}</strong></td>
              <td><strong>{{this.store.name}}</strong></td>
              <td>{{formatDate this.generatedAt}}</td>
              <td>{{this.inspector.fullName}}</td>
              <td><strong>{{this.finalScore}}%</strong></td>
              <td><span class="quantity-pill" style="font-weight:bold;">{{this.grade}}</span></td>
              <td><span class="quantity-pill">{{statusLabel this.status}}</span></td>
              <td>
                <div class="product-actions" style="display:flex;gap:6px;align-items:center;">
                  <button type="button" class="edit-product-button" style="padding:6px 12px;font-size:12px;display:inline-flex;align-items:center;gap:4px;cursor:pointer;" onclick="openReportModal('{{this.id}}')" title="Preview Report In Modal">
                    <i class="fas fa-eye text-blue-600"></i> Preview Report
                  </button>
                  <button type="button" class="hero-button" style="padding:6px 12px;font-size:12px;background:#0f172a;display:inline-flex;align-items:center;gap:4px;cursor:pointer;" onclick="openReportModal('{{this.id}}', true)" title="Export to PDF or Print">
                    <i class="fas fa-file-export text-emerald-400"></i> Export / Print
                  </button>
                </div>
              </td>
            </tr>
          {{else}}
            <tr>
              <td colspan="8">No reports yet. A report is created automatically when an inspection is finished.</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

{{#if isAdmin}}
    </main>
  </div>
{{else}}
  {{#if isInspector}}
    </main>
  </div>
  {{else}}
    {{#if isStoreRep}}
      </main>
    </div>
    {{else}}
      </main>
    {{/if}}
  {{/if}}
{{/if}}
{{> report-modal}}
{{> footer}}
