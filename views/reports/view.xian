{{> head}}
<style>
  /* A4 Document Preview on Screen */
  .preview-sheet {
    max-width: 960px;
    margin: 0 auto;
    background: #ffffff;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.08), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
    border: 1px solid #e2e8f0;
    transition: all 0.2s ease-in-out;
  }
  @media print {
    /* Hide all web chrome, navbars, and buttons */
    .no-print, nav, header, footer, .admin-sidebar, .admin-header, .shop-nav, #alert-container {
      display: none !important;
    }
    body {
      background: #ffffff !important;
      color: #000000 !important;
      font-size: 11pt !important;
      padding: 0 !important;
      margin: 0 !important;
    }
    main {
      padding: 0 !important;
      margin: 0 !important;
      width: 100% !important;
      max-width: 100% !important;
    }
    .preview-sheet {
      border: none !important;
      box-shadow: none !important;
      padding: 0 !important;
      margin: 0 !important;
      width: 100% !important;
      max-width: 100% !important;
    }
    .print-avoid-break {
      break-inside: avoid !important;
      page-break-inside: avoid !important;
    }
    @page {
      size: A4 portrait;
      margin: 12mm 12mm 12mm 12mm;
    }
  }
</style>
<body class="flex flex-col min-h-screen bg-slate-100 text-slate-800">
  {{> navbar}}
  {{> alerts}}

  <main class="flex-grow py-8 px-4 sm:px-6 w-full space-y-6">
    
    <!-- Action Bar (Hidden in Print) -->
    <div class="no-print max-w-[960px] mx-auto flex flex-col sm:flex-row items-center justify-between bg-white p-4 rounded-2xl border border-slate-200 shadow-sm gap-4">
      <div class="flex items-center space-x-2">
        <a href="javascript:history.back()" class="px-3 py-1.5 rounded-lg border border-slate-200 text-sm font-semibold text-slate-600 hover:text-slate-900 hover:bg-slate-50 flex items-center gap-1.5 transition-colors">
          <i class="fas fa-arrow-left text-xs"></i> Back
        </a>
        <span class="text-slate-300">|</span>
        <span class="text-sm font-mono font-bold text-slate-800">{{report.reportCode}}</span>
        <span class="px-2.5 py-0.5 rounded-full text-[11px] font-extrabold bg-blue-50 text-blue-700 border border-blue-200 flex items-center gap-1">
          <i class="fas fa-eye text-[10px]"></i> Preview Mode
        </span>
      </div>

      <div class="flex items-center space-x-2.5">
        <button id="view-export-pdf-btn" onclick="exportViewToPdf()" class="px-4 py-2 rounded-xl bg-white border-2 border-rose-600 hover:bg-rose-50 text-rose-700 font-extrabold text-sm shadow-sm flex items-center gap-2 transition-all hover:scale-[1.02] cursor-pointer">
          <i class="fas fa-file-pdf text-rose-600"></i> Export to PDF
        </button>
        <button onclick="window.print()" class="px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-extrabold text-sm shadow-md flex items-center gap-2 transition-all hover:scale-[1.02] cursor-pointer">
          <i class="fas fa-print"></i> Print Official Record
        </button>
      </div>
    </div>

    <!-- Preview Notice Banner (Hidden in Print) -->
    <div class="no-print max-w-[960px] mx-auto bg-blue-50/80 border border-blue-200 text-blue-900 px-4 py-3 rounded-2xl flex flex-col sm:flex-row items-center justify-between text-xs gap-3">
      <div class="flex items-center gap-3">
        <span class="w-8 h-8 rounded-xl bg-blue-600 text-white flex items-center justify-center font-bold text-sm shrink-0 shadow-sm">
          <i class="fas fa-file-invoice"></i>
        </span>
        <div>
          <span class="font-bold text-slate-900 block text-sm">Official Inspection Report &amp; Certificate Preview</span>
          <span class="text-slate-600">Review all audit scores, store compliance details, and logged findings below. You can print or save as PDF anytime.</span>
        </div>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <button onclick="window.print()" class="px-3.5 py-1.5 rounded-lg bg-blue-700 hover:bg-blue-800 text-white font-bold text-xs shadow-sm flex items-center gap-1.5 transition-colors">
          <i class="fas fa-download"></i> Export / Print Now
        </button>
      </div>
    </div>

    <!-- Official Printable Document Container (A4 Sheet Preview) -->
    <div id="view-report-sheet" class="preview-sheet print-doc rounded-2xl p-8 sm:p-12 space-y-8 print:border-0 print:shadow-none print:p-0">
      {{> report-document}}
    </div>

  </main>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
  <script>
    window.exportViewToPdf = function() {
      const element = document.getElementById('view-report-sheet');
      const btn = document.getElementById('view-export-pdf-btn');
      if (!element) return;

      const reportCode = '{{report.reportCode}}'.trim() || 'Report';
      const originalText = btn.innerHTML;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin text-rose-600"></i> Generating PDF...';
      btn.disabled = true;

      const opt = {
        margin: [10, 8, 10, 8],
        filename: `DALI_Inspection_${reportCode}.pdf`,
        image: { type: 'jpeg', quality: 0.98 },
        html2canvas: { scale: 2, useCORS: true, logging: false },
        jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
      };

      if (window.html2pdf) {
        window.html2pdf().set(opt).from(element).save().then(() => {
          btn.innerHTML = '<i class="fas fa-check text-emerald-600"></i> Downloaded!';
          setTimeout(() => {
            btn.innerHTML = originalText;
            btn.disabled = false;
          }, 1500);
        }).catch(err => {
          console.error('PDF generation failed:', err);
          btn.innerHTML = originalText;
          btn.disabled = false;
          window.print();
        });
      } else {
        btn.innerHTML = originalText;
        btn.disabled = false;
        window.print();
      }
    };
  </script>

  {{#if autoPrint}}
  <script>
    window.addEventListener('DOMContentLoaded', () => {
      setTimeout(() => {
        window.print();
      }, 500);
    });
  </script>
  {{/if}}

  {{> footer}}
</body>
</html>
