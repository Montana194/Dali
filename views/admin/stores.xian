{{> head}}
<body class="storefront">
{{> admin-header}}
<div class="admin-shell">
  {{> admin-sidebar}}
  <main class="admin-content">
    <div class="admin-title">
      <div>
        <p class="eyebrow">STORE BRANCHES</p>
        <h1>DALI Store Branches</h1>
      </div>
      <button onclick="document.getElementById('addStoreModal').classList.remove('hidden')" class="hero-button">+ Add a Branch</button>
    </div>
    <p class="admin-intro">See every branch, who manages it, and its latest inspection result.</p>

    {{#if success_msg}}<p class="admin-notice" role="status">{{success_msg}}</p>{{/if}}
    {{#if error_msg}}<p class="admin-notice admin-notice-error" role="alert">{{error_msg}}</p>{{/if}}

    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th scope="col">Branch Code</th>
            <th scope="col">Store Name</th>
            <th scope="col">Address</th>
            <th scope="col">Store Manager</th>
            <th scope="col">Status</th>
            <th scope="col">Latest Score</th>
            <th scope="col">Action</th>
          </tr>
        </thead>
        <tbody>
          {{#each stores}}
            <tr>
              <td><strong>{{this.code}}</strong></td>
              <td><strong>{{this.name}}</strong><small>{{this.city}}, {{this.region}}</small></td>
              <td>{{this.address}}</td>
              <td>{{this.managerName}}<small>{{this.contactPhone}}</small></td>
              <td><span class="quantity-pill" style="font-weight:bold;">{{statusLabel this.complianceStatus}}</span></td>
              <td><strong>{{this.overallRating}}%</strong></td>
              <td>
                <div class="product-actions">
                  <a class="edit-product-button" href="/admin/schedule">Schedule Inspection</a>
                </div>
              </td>
            </tr>
          {{else}}
            <tr>
              <td colspan="7">No store branches yet. Click “+ Add a Branch” to add one.</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <!-- Modal for adding new store branch -->
    <div id="addStoreModal" class="hidden fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4">
      <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-200">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-4">
          <h3 class="font-bold text-slate-900 text-lg">Add a New Store Branch</h3>
          <button onclick="document.getElementById('addStoreModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600 text-lg" aria-label="Close">✕</button>
        </div>

        <form method="POST" action="/admin/stores" class="admin-user-form space-y-3 text-sm">
          <input type="hidden" name="_csrf" value="{{shopToken}}">
          <label>Branch Code</label>
          <input type="text" name="code" placeholder="e.g. DALI-MNL-005" required>

          <label>Store Name</label>
          <input type="text" name="name" placeholder="e.g. DALI Everyday Grocery – Makati Bangkal" required>

          <label>Full Address</label>
          <input type="text" name="address" placeholder="Street, Barangay, City" required>

          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div>
              <label>City</label>
              <input type="text" name="city" value="Metro Manila" required>
            </div>
            <div>
              <label>Region</label>
              <input type="text" name="region" value="NCR" required>
            </div>
          </div>

          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div>
              <label>Store Manager</label>
              <input type="text" name="managerName" placeholder="Manager's full name">
            </div>
            <div>
              <label>Contact Number</label>
              <input type="text" name="contactPhone" placeholder="e.g. (02) 8123 4567">
            </div>
          </div>

          <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:14px;">
            <button type="button" onclick="document.getElementById('addStoreModal').classList.add('hidden')" class="edit-product-button">Cancel</button>
            <button type="submit" class="hero-button">Save Branch</button>
          </div>
        </form>
      </div>
    </div>

  </main>
</div>
{{> footer}}
