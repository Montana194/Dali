{{> head}}
<body class="storefront">
{{> admin-header}}
<div class="admin-shell">
  {{> admin-sidebar}}
  <main class="admin-content">
    <p class="eyebrow">INTEGRATION &amp; CONNECTIONS</p>
    <h1>DALITrack Integration Hub</h1>
    <p class="admin-intro">Manage cross-module connections to <strong>DALIStock</strong> and <strong>DALI POS</strong> for branch, inventory, and sales synchronization.</p>

    {{#if success_msg}}<p class="admin-notice" role="status">{{success_msg}}</p>{{/if}}
    {{#if error_msg}}<p class="admin-notice admin-notice-error" role="alert">{{error_msg}}</p>{{/if}}

    <!-- Connection Summary Cards -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(280px, 1fr));gap:20px;margin-bottom:28px;">
      
      <!-- Card 1: DALI POS Connection -->
      <div class="admin-panel" style="padding:20px;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
          <h3 style="margin:0;font-size:16px;font-weight:700;"><i class="fas fa-cash-register" style="color:#0284c7;margin-right:8px;"></i> DALI POS Server</h3>
          {{#if posTestResult.ok}}
            <span class="quantity-pill" style="background:#ecfdf5;color:#047857;border-color:#a7f3d0;"><i class="fas fa-circle-check"></i> Connected</span>
          {{else}}
            {{#if posTestResult}}
              <span class="quantity-pill" style="background:#fef2f2;color:#b91c1c;border-color:#fecaca;"><i class="fas fa-triangle-exclamation"></i> Error</span>
            {{else}}
              <span class="quantity-pill" style="background:#f8fafc;color:#64748b;border-color:#e2e8f0;">Ready to Test</span>
            {{/if}}
          {{/if}}
        </div>
        <div style="font-size:13px;color:#475569;line-height:1.6;">
          <p style="margin:4px 0;"><strong>Target URL:</strong> <code>{{posUrl}}</code></p>
          <p style="margin:4px 0;"><strong>Endpoints:</strong> <code>/products</code>, <code>/inventory</code>, <code>/sales</code></p>
          <p style="margin:4px 0;"><strong>Bearer Token:</strong> {{#if hasPosToken}}<span style="color:#059669;font-weight:600;"><i class="fas fa-key"></i> Registered (32+ bytes)</span>{{else}}<span style="color:#dc2626;font-weight:600;"><i class="fas fa-lock"></i> Missing in .env</span>{{/if}}</p>
          <p style="margin:4px 0;"><strong>Profile:</strong> Read-Only HTTP API</p>
        </div>
      </div>

      <!-- Card 2: DALIStock Connection -->
      <div class="admin-panel" style="padding:20px;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
          <h3 style="margin:0;font-size:16px;font-weight:700;"><i class="fas fa-boxes-stacked" style="color:#e11d48;margin-right:8px;"></i> DALIStock Server</h3>
          {{#if testResult.ok}}
            <span class="quantity-pill" style="background:#ecfdf5;color:#047857;border-color:#a7f3d0;"><i class="fas fa-circle-check"></i> Connected</span>
          {{else}}
            {{#if testResult}}
              <span class="quantity-pill" style="background:#fef2f2;color:#b91c1c;border-color:#fecaca;"><i class="fas fa-triangle-exclamation"></i> Error</span>
            {{else}}
              <span class="quantity-pill" style="background:#f8fafc;color:#64748b;border-color:#e2e8f0;">Ready to Test</span>
            {{/if}}
          {{/if}}
        </div>
        <div style="font-size:13px;color:#475569;line-height:1.6;">
          <p style="margin:4px 0;"><strong>Target URL:</strong> <code>{{stockUrl}}</code></p>
          <p style="margin:4px 0;"><strong>Branch Scope:</strong> <code>{{stockBranch}}</code> (Calapan)</p>
          <p style="margin:4px 0;"><strong>Token Status:</strong> {{#if hasToken}}<span style="color:#059669;font-weight:600;"><i class="fas fa-key"></i> Registered in .env</span>{{else}}<span style="color:#dc2626;font-weight:600;"><i class="fas fa-lock"></i> Missing in .env</span>{{/if}}</p>
          <p style="margin:4px 0;"><strong>Profile:</strong> Read-Only (Catalog &amp; Branches)</p>
        </div>
      </div>

      <!-- Card 3: DALIAudit Inbound Status -->
      <div class="admin-panel" style="padding:20px;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
          <h3 style="margin:0;font-size:16px;font-weight:700;"><i class="fas fa-shield-halved" style="color:#059669;margin-right:8px;"></i> DALIAudit Host</h3>
          <span class="quantity-pill" style="background:#ecfdf5;color:#047857;border-color:#a7f3d0;"><i class="fas fa-circle"></i> Active</span>
        </div>
        <div style="font-size:13px;color:#475569;line-height:1.6;">
          <p style="margin:4px 0;"><strong>Listening Interface:</strong> <code>0.0.0.0:{{port}}</code></p>
          <p style="margin:4px 0;"><strong>Inbound Routes:</strong> <code>/api/health</code>, <code>/api/stores</code>, <code>/api/inspections</code></p>
          <p style="margin:4px 0;"><strong>Auth Method:</strong> <code>Bearer &lt;DALIAUDIT_API_TOKEN&gt;</code></p>
          <p style="margin:4px 0;"><strong>Cookie Scope:</strong> <code>daliaudit.sid</code> (Isolated)</p>
        </div>
      </div>

    </div>

    <!-- DALI POS Connection Action Panel -->
    <section class="admin-panel" style="margin-bottom:28px;">
      <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;border-bottom:1px solid #f1f5f9;padding-bottom:16px;margin-bottom:16px;">
        <div>
          <h2 style="margin:0;font-size:18px;"><i class="fas fa-cash-register" style="color:#0284c7;margin-right:8px;"></i> DALI POS Live Diagnostics</h2>
          <p style="margin:4px 0 0;font-size:14px;color:#64748b;">Execute live diagnostic probe against DALI POS <code>/health</code>, <code>/products</code>, and <code>/inventory</code> on <code>{{posUrl}}</code>.</p>
        </div>
        <form method="POST" action="/admin/integrations/test-pos">
          <input type="hidden" name="_csrf" value="{{shopToken}}">
          <button type="submit" class="hero-button" style="display:inline-flex;align-items:center;gap:8px;background:#0284c7;">
            <i class="fas fa-play"></i> Test DALI POS Connection
          </button>
        </form>
      </div>

      {{#if posTestResult}}
        <div style="padding:16px;border-radius:12px;background:{{#if posTestResult.ok}}#f0fdf4;border:1px solid #bbf7d0;{{else}}#fff1f2;border:1px solid #fecdd3;{{/if}}">
          <h3 style="margin:0 0 8px;font-size:15px;color:{{#if posTestResult.ok}}#166534{{else}}#9f1239{{/if}};">
            {{#if posTestResult.ok}}
              <i class="fas fa-circle-check" style="margin-right:6px;"></i> DALI POS Connected Successfully
            {{else}}
              <i class="fas fa-circle-xmark" style="margin-right:6px;"></i> DALI POS Connection Probe Failed
            {{/if}}
          </h3>
          
          <ul style="margin:0;padding-left:20px;font-size:13px;line-height:1.8;color:{{#if posTestResult.ok}}#14532d{{else}}#881337{{/if}};">
            <li><strong>Timestamp:</strong> {{posTestResult.timestamp}}</li>
            {{#if posTestResult.ok}}
              <li><strong>Service:</strong> <code>{{posTestResult.service}}</code> (status: {{posTestResult.status}})</li>
              <li><strong>Capabilities:</strong> {{#each posTestResult.capabilities}}<span class="quantity-pill" style="font-size:11px;margin-right:4px;">{{this}}</span>{{/each}}</li>
              <li><strong>Products Found:</strong> {{posTestResult.productsCount}} items</li>
              <li><strong>Inventory Records:</strong> {{posTestResult.inventoryCount}} stock records</li>
            {{else}}
              <li><strong>Error Detail:</strong> {{posTestResult.error}}</li>
              <li style="margin-top:6px;font-style:italic;">Ensure DALI POS is running on port 3000 at <code>{{posUrl}}</code> with <code>DALI_POS_INTEGRATION_TOKEN</code> configured.</li>
            {{/if}}
          </ul>
        </div>
      {{else}}
        <p style="font-size:14px;color:#64748b;margin:0;">Click the button above to probe DALI POS.</p>
      {{/if}}
    </section>

    <!-- DALIStock Connection Action Panel -->
    <section class="admin-panel" style="margin-bottom:28px;">
      <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;border-bottom:1px solid #f1f5f9;padding-bottom:16px;margin-bottom:16px;">
        <div>
          <h2 style="margin:0;font-size:18px;"><i class="fas fa-boxes-stacked" style="color:#e11d48;margin-right:8px;"></i> DALIStock Live Diagnostics</h2>
          <p style="margin:4px 0 0;font-size:14px;color:#64748b;">Execute live end-to-end verification against DALIStock's <code>/health</code>, <code>/branches</code>, and <code>/products</code>.</p>
        </div>
        <form method="POST" action="/admin/integrations/test-stock">
          <input type="hidden" name="_csrf" value="{{shopToken}}">
          <button type="submit" class="hero-button" style="display:inline-flex;align-items:center;gap:8px;">
            <i class="fas fa-play"></i> Test DALIStock Connection
          </button>
        </form>
      </div>

      {{#if testResult}}
        <div style="padding:16px;border-radius:12px;background:{{#if testResult.ok}}#f0fdf4;border:1px solid #bbf7d0;{{else}}#fff1f2;border:1px solid #fecdd3;{{/if}}">
          <h3 style="margin:0 0 8px;font-size:15px;color:{{#if testResult.ok}}#166534{{else}}#9f1239{{/if}};">
            {{#if testResult.ok}}
              <i class="fas fa-circle-check" style="margin-right:6px;"></i> Connection Verified Successfully
            {{else}}
              <i class="fas fa-circle-xmark" style="margin-right:6px;"></i> Connection Verification Failed
            {{/if}}
          </h3>
          
          <ul style="margin:0;padding-left:20px;font-size:13px;line-height:1.8;color:{{#if testResult.ok}}#14532d{{else}}#881337{{/if}};">
            <li><strong>Timestamp:</strong> {{testResult.timestamp}}</li>
            {{#if testResult.ok}}
              <li><strong>Target System:</strong> <code>{{testResult.system}}</code> (status: {{testResult.status}})</li>
              <li><strong>Authenticated Source:</strong> <code>{{testResult.source}}</code> {{#if (eq testResult.source "DALIAudit")}}<span style="color:#16a34a;font-weight:700;">(Exact Match)</span>{{else}}<span style="color:#d97706;font-weight:700;">(Warning: Source is not DALIAudit)</span>{{/if}}</li>
              <li><strong>Branches Available:</strong> {{testResult.branchesCount}} branch(es) permitted (Target: <code>{{testResult.targetBranch}}</code>)</li>
              <li><strong>Catalog Scope:</strong> {{testResult.productsCount}} product(s) accessible</li>
            {{else}}
              <li><strong>Error Detail:</strong> {{testResult.error}}</li>
              <li style="margin-top:6px;font-style:italic;">Make sure DALIStock is running on the other laptop at <code>{{stockUrl}}</code> and the <strong>DALIAudit</strong> credential was issued in Stock's Connections.</li>
            {{/if}}
          </ul>
        </div>
      {{else}}
        <p style="font-size:14px;color:#64748b;margin:0;">Click the button above to run diagnostic probes against DALIStock.</p>
      {{/if}}
    </section>

    <!-- Integration Rules & Defense Standards -->
    <section class="admin-panel">
      <h2>Architecture &amp; Data Ownership Guidelines</h2>
      <div style="font-size:13px;color:#475569;line-height:1.7;">
        <p><strong>1. HTTP Service Boundaries:</strong> DALIAudit and DALI POS never connect directly to each other's MySQL databases. All exchanges occur over secure, authenticated HTTP APIs.</p>
        <p><strong>2. Discrete Token Separation:</strong> Outbound requests from DALIAudit to POS carry <code>DALI_POS_INTEGRATION_TOKEN</code>. Inbound requests from POS carry <code>DALIAUDIT_API_TOKEN</code>.</p>
        <p><strong>3. Read-Only Constraint:</strong> DALIAudit strictly consumes read-only catalog, inventory, and sales endpoints. No sales are voided, no products altered, and no inventory deducted.</p>
      </div>
    </section>

  </main>
</div>
{{> footer}}
