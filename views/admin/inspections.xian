{{> head}}
<body class="storefront">
{{> admin-header}}
<div class="admin-shell">
  {{> admin-sidebar}}
  <main class="admin-content">
    <div class="admin-title">
      <div>
        <p class="eyebrow">INSPECTION HISTORY</p>
        <h1>All Inspections</h1>
      </div>
      <a href="/admin/schedule" class="hero-button">+ Schedule an Inspection</a>
    </div>
    <p class="admin-intro">Every inspection across all branches — its status, score, and report.</p>

    {{#if success_msg}}<p class="admin-notice" role="status">{{success_msg}}</p>{{/if}}
    {{#if error_msg}}<p class="admin-notice admin-notice-error" role="alert">{{error_msg}}</p>{{/if}}

    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th scope="col">Inspection No.</th>
            <th scope="col">Store</th>
            <th scope="col">Inspector</th>
            <th scope="col">Date</th>
            <th scope="col">Status</th>
            <th scope="col">Score</th>
            <th scope="col">Report</th>
          </tr>
        </thead>
        <tbody>
          {{#each inspections}}
            <tr>
              <td><strong>{{this.inspectionCode}}</strong></td>
              <td>
                <strong>{{this.store.name}}</strong>
                {{#if this.stockBranchCode}}
                  <div style="font-size:11px;color:#9d174d;margin-top:2px;">
                    <i class="fas fa-boxes-stacked"></i> Stock: <strong>{{this.stockBranchCode}}</strong>{{#if this.stockSku}} &bull; SKU: {{this.stockSku}}{{/if}}
                  </div>
                {{/if}}
              </td>
              <td>{{this.inspector.fullName}}</td>
              <td>{{formatDate this.inspectionDate}}</td>
              <td><span class="quantity-pill">{{statusLabel this.status}}</span></td>
              <td><strong>{{this.score}}%</strong></td>
              <td>
                <div class="product-actions" style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
                  <a class="edit-product-button" style="padding:6px 12px;font-size:12px;display:inline-flex;align-items:center;gap:4px;" href="/reports/view/{{#if this.report}}{{this.report.id}}{{else}}{{this.id}}{{/if}}" title="Preview Full Report On Screen">
                    <i class="fas fa-eye text-blue-600"></i> Preview Report
                  </a>
                  <a class="hero-button" style="padding:6px 12px;font-size:12px;background:#0f172a;display:inline-flex;align-items:center;gap:4px;" href="/reports/view/{{#if this.report}}{{this.report.id}}{{else}}{{this.id}}{{/if}}?print=true" target="_blank" title="Export as PDF or Print Record">
                    <i class="fas fa-file-export text-emerald-400"></i> Export / Print
                  </a>
                </div>
              </td>
            </tr>
          {{else}}
            <tr>
              <td colspan="7">No inspections yet.</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </main>
</div>
{{> footer}}
