{{> head}}
<body class="flex flex-col min-h-screen bg-slate-50 text-slate-800">
  {{> navbar}}
  {{> alerts}}

  <main class="flex-grow py-8 max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 w-full space-y-6">
    
    <!-- Title -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
      <div>
        <h1 class="text-xl font-extrabold text-slate-900 tracking-tight">
          {{#if editing}}Edit User Account{{else}}Add New User Account{{/if}}
        </h1>
        <p class="text-xs text-slate-500 mt-0.5">
          {{#if editing}}Update account details, role permissions, and branch assignments.{{else}}Create an account and assign a role-based access level.{{/if}}
        </p>
      </div>
      <a href="/admin/users" class="text-xs font-semibold text-slate-500 hover:text-slate-800">
        &larr; Back to Users
      </a>
    </div>

    {{#if error}}
      <div class="bg-rose-50 border-l-4 border-rose-500 p-4 rounded-r-lg shadow-sm flex items-center">
        <i class="fas fa-exclamation-triangle text-rose-500 mr-3"></i>
        <p class="text-xs font-semibold text-rose-800">{{error}}</p>
      </div>
    {{/if}}

    <!-- Form Panel (modeled after act9 admin-user-form) -->
    <div class="bg-white p-6 sm:p-8 rounded-2xl border border-slate-200 shadow-sm">
      <form method="POST" action="{{#if editing}}/admin/users/{{values.id}}/edit{{else}}/admin/users{{/if}}" class="space-y-4 text-xs">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">

        <div>
          <label for="user-name" class="block font-semibold text-slate-700 mb-1">Full Name</label>
          <input 
            id="user-name" 
            name="name" 
            type="text" 
            value="{{values.fullName}}" 
            maxlength="120" 
            autocomplete="name" 
            placeholder="e.g. Maria Santos"
            class="w-full p-2.5 border border-slate-300 rounded-lg outline-none focus:ring-1 focus:ring-dali-600 bg-white" 
            required
          >
        </div>

        <div>
          <label for="user-email" class="block font-semibold text-slate-700 mb-1">Email Address</label>
          <input 
            id="user-email" 
            name="email" 
            type="email" 
            value="{{values.email}}" 
            maxlength="254" 
            autocomplete="email" 
            placeholder="e.g. msantos@dali.ph"
            class="w-full p-2.5 border border-slate-300 rounded-lg outline-none focus:ring-1 focus:ring-dali-600 bg-white" 
            required
          >
        </div>

        <div>
          <label for="user-password" class="block font-semibold text-slate-700 mb-1">
            {{#if editing}}New Password (optional){{else}}Password{{/if}}
          </label>
          <input 
            id="user-password" 
            name="password" 
            type="password" 
            minlength="6" 
            maxlength="72" 
            autocomplete="new-password" 
            placeholder="••••••••"
            class="w-full p-2.5 border border-slate-300 rounded-lg outline-none focus:ring-1 focus:ring-dali-600 bg-white" 
            {{#unless editing}}required{{/unless}}
          >
          <p class="text-[11px] text-slate-400 mt-1">
            Must contain at least 6 characters.{{#if editing}} Leave blank to retain current password.{{/if}}
          </p>
        </div>

        <div>
          <label for="user-role" class="block font-semibold text-slate-700 mb-1">System Access Role</label>
          <select 
            id="user-role" 
            name="role" 
            class="w-full p-2.5 border border-slate-300 rounded-lg outline-none focus:ring-1 focus:ring-dali-600 bg-white" 
            onchange="toggleStoreField(this.value)"
            required 
            {{#if isSelf}}disabled{{/if}}
          >
            {{#each roles}}
              <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
            {{/each}}
          </select>
          {{#if isSelf}}
            <input type="hidden" name="role" value="admin">
            <p class="text-[11px] text-amber-600 font-medium mt-1">Your current account must remain an administrator.</p>
          {{/if}}
          <p class="text-[11px] text-slate-400 mt-1">
            Admins govern the system. Inspectors execute field audits. Store Representatives manage branch compliance.
          </p>
        </div>

        <div id="storeSelectionWrap">
          <label for="storeId" class="block font-semibold text-slate-700 mb-1">Assigned DALI Store Branch</label>
          <select id="storeId" name="storeId" class="w-full p-2.5 border border-slate-300 rounded-lg outline-none focus:ring-1 focus:ring-dali-600 bg-white">
            <option value="">-- None / Headquarters --</option>
            {{#each stores}}
              <option value="{{this.id}}" {{#if (eq ../values.storeId this.id)}}selected{{/if}}>{{this.name}} ({{this.code}})</option>
            {{/each}}
          </select>
        </div>

        <div>
          <label for="phone" class="block font-semibold text-slate-700 mb-1">Contact Phone Number (Optional)</label>
          <input 
            id="phone" 
            name="phone" 
            type="text" 
            value="{{values.phone}}" 
            placeholder="+63 9XX XXX XXXX"
            class="w-full p-2.5 border border-slate-300 rounded-lg outline-none focus:ring-1 focus:ring-dali-600 bg-white"
          >
        </div>

        <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3">
          <a href="/admin/users" class="px-4 py-2.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold transition-colors">
            Cancel
          </a>
          <button type="submit" class="px-6 py-2.5 rounded-lg bg-dali-700 hover:bg-dali-800 text-white font-bold shadow-sm transition-all">
            {{#if editing}}Save Changes{{else}}Add User{{/if}}
          </button>
        </div>
      </form>
    </div>

  </main>

  <script>
    function toggleStoreField(role) {
      const wrap = document.getElementById('storeSelectionWrap');
      if (role === 'store_rep') {
        wrap.style.display = 'block';
      } else {
        wrap.style.display = 'none';
      }
    }
    // Initialize state
    const currentRole = document.getElementById('user-role')?.value;
    if (currentRole) toggleStoreField(currentRole);
  </script>

  {{> footer}}
</body>
</html>
