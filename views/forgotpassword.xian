{{> head}}
<body class="flex flex-col min-h-screen bg-slate-50 text-slate-800">
  {{> navbar}}
  {{> alerts}}

  <div class="flex-grow flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-6">
      
      <div class="text-center">
        <div class="inline-flex items-center justify-center h-16 w-16 rounded-2xl bg-white p-2 shadow-md border border-slate-200 mb-3">
          <img src="/images/dali-logo.png" alt="DALI Logo" class="h-full object-contain">
        </div>
        <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">
          Forgot Your Password?
        </h2>
        <p class="text-base text-slate-500 mt-1">
          Don't worry — your administrator can help you get back in.
        </p>
      </div>

      <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-slate-200 space-y-4">
        <div class="w-12 h-12 rounded-full bg-dali-50 text-dali-700 flex items-center justify-center mx-auto text-xl">
          <i class="fas fa-key"></i>
        </div>
        <p class="text-base text-slate-700 text-center leading-relaxed">
          For security, passwords can only be reset by a DALIAudit administrator.
        </p>
        <ol class="list-decimal pl-5 space-y-2 text-base text-slate-700 bg-slate-50 p-4 rounded-xl border border-slate-200">
          <li>Contact your administrator or the Quality Assurance team.</li>
          <li>Give them the email address you used to register.</li>
          <li>They will set a new password for you so you can sign in again.</li>
        </ol>
        <div class="pt-2 text-center">
          <a href="/account/login" class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-dali-700 hover:bg-dali-800 text-white font-bold text-sm">
            ← Back to Sign In
          </a>
        </div>
      </div>

    </div>
  </div>

  {{> footer}}
</body>
</html>
